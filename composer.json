{
    "name": "ernestdefoe/espn-cfb-ticker",
    "description": "A FBS college football scores ticker powered by the ESPN API for Flarum 2.",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "ernestdefoe",
            "email": "ernestdefoe@gmail.com",
            "homepage": "https://github.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\EspnCfbTicker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\EspnCfbTicker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "ESPN CFB Ticker",
            "category": "feature",
            "icon": {
                "name": "fas fa-football-ball",
                "backgroundColor": "#cc0000",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
